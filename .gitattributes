# 统一换行：仓库内存 LF，避免 Windows/macOS/Linux 互相污染 diff
* text=auto eol=lf

# Windows 批处理必须在 checkout 后保持 CRLF，否则 cmd 解析出错
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制：不做换行转换，也不做文本 diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.faiss binary
*.pkl  binary
*.bin  binary

# 下面这些在 GitHub 上按语言高亮
*.css  linguist-language=CSS
*.bat  linguist-language=Batchfile
