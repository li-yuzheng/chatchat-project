# ============================================================
# 环境变量模板
#
# 用法：复制成项目根目录的 .env，再填上你自己的密钥
#     Windows     copy .env.example .env
#     macOS/Linux cp .env.example .env
#
# 说明：
#   1. .env 已在 .gitignore 中（第 17 行），不会被提交。本文件是模板，可以提交。
#   2. 千万不要把真实密钥写进本文件，它是要进 git 的。
#   3. 解析规则（_env.py::_load_dotenv）：一行一个 KEY=VALUE，
#      只支持【整行注释】，值后面不要再跟 # 说明，否则会被当成值的一部分。
#   4. 这里的值会【覆盖】同名的系统环境变量，所以排查问题时以本文件为准。
# ============================================================


# ------------------------------------------------------------
# 必填：大模型 API Key
# ------------------------------------------------------------
# 获取地址：https://platform.deepseek.com/api_keys
# 格式形如 sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx（32 位以上）
# 留空会报 401 Authentication Fails —— 也就是说，"没填"和"填错"报的是同一个错。
DEEPSEEK_API_KEY=


# ------------------------------------------------------------
# 可选：运行环境
# ------------------------------------------------------------
# 数据目录，存放 model_settings.yaml、知识库索引、日志、上传的临时文件。
# 不填则使用 _env.py 顶部的默认值（当前为 D:\chatchat-data）。
# 换机器部署时通常只需要改这一个变量。
# CHATCHAT_ROOT=D:\chatchat-data

# 是否优先加载 src/ 下可编辑的源码。默认 1（优先源码，改完即时生效，
# 不会被 site-packages 里的旧版本盖住）；设为 0 则走 pip 安装的版本。
# CHATCHAT_USE_SRC=1


# ------------------------------------------------------------
# 可选：离线开发（没有 API Key 时用）
# ------------------------------------------------------------
# tools/mock_llm_server.py 是一个 OpenAI 兼容的桩服务，只回显最后一条消息，
# 用来验证「配置 -> 客户端 -> 请求 -> 流式解析」整条链路，不花钱、不联网。
#
#   1) 启动桩服务：  python tools\mock_llm_server.py --port 7999
#   2) 在 model_settings.yaml 里注册一个平台：
#        platform_name: mock
#        platform_type: custom openai
#        api_base_url: http://127.0.0.1:7999/v1
#        api_key: EMPTY
#        llm_models: [mock-chat]
#   3) 把 DEFAULT_LLM_MODEL 切成 mock-chat
#
# 这种方式不需要任何环境变量，下面两行只是记录约定，保持注释即可。
# MOCK_LLM_BASE=http://127.0.0.1:7999/v1
# MOCK_LLM_API_KEY=EMPTY
